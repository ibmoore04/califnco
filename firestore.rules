rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Administrator privileges verified via trusted Firebase Auth custom claims,
    // root admin UID, or verified admin account email.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid == "KIjD31YuSmdzxDgbjzvGkrxkJra2" ||
        request.auth.token.email == "akanbiibrahimolatunde27@gmail.com"
      );
    }

    // 1. PRODUCTS: Public catalog read; only authenticated administrators can mutate
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. USERS: User can read and manage their own profile document.
    // Users are strictly registered with 'customer' role.
    // Only verified administrators (with custom claims) can update other user documents or assign elevated roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
        
      allow delete: if isAdmin();
    }

    // 3. ORDERS: Customers can only read and create their own orders with initial 'pending' status.
    // Status updates, fulfillment, and cancellations are restricted to Administrators.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
        
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
        
      allow update, delete: if isAdmin();
    }

    // 4. DEALERS: Dealer applications can be created by authenticated applicant with 'pending' status.
    // The dealer document ID and internal 'id' field must equal the applicant's Firebase Auth UID.
    // Review and status approvals restricted to Administrators.
    match /dealers/{dealerId} {
      allow read: if isOwner(dealerId) || isAdmin();
      allow create: if isOwner(dealerId) && 
        request.resource.data.id == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 5. SERVICES: Service bookings can be created and read by the customer or admin.
    // Technician dispatch, scheduling, and completion updates are restricted to Administrators.
    match /services/{serviceId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == 'submitted' || request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // 6. NOTIFICATIONS: In-app operational notifications readable by recipient or admin.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Default catch-all: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
