# Califnco Assignment - Environment Variables Example
# Duplicate this file to .env in respective app directories and fill in test credentials.
# NEVER commit real API keys, secret keys, or service account files to git.

# --- Firebase Configuration (Client-side / Free Spark Plan) ---
FIREBASE_API_KEY=placeholder_api_key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# --- Razorpay Test Mode (Zero KYC / Free test keys) ---
RAZORPAY_KEY_ID=rzp_test_placeholder123456

# --- Maps / Geocoding (Free alternatives: Geoapify, MapTiler, OpenStreetMap) ---
MAPTILER_API_KEY=placeholder_maptiler_key
GEOAPIFY_API_KEY=placeholder_geoapify_key

# --- Notifications ---
EMAILJS_SERVICE_ID=service_placeholder
EMAILJS_TEMPLATE_ID=template_placeholder
EMAILJS_PUBLIC_KEY=placeholder_public_key
TEXTBEE_API_KEY=placeholder_textbee_api_key
TEXTBEE_DEVICE_ID=placeholder_device_id

# --- AI Automation (Instagram / Image / Caption Gen) ---
# NOTE: User's Instagram account is currently blocked/banned. Keep as external mock/staged dependency.
GEMINI_API_KEY=placeholder_gemini_key
GROQ_API_KEY=placeholder_groq_key
HUGGINGFACE_API_TOKEN=placeholder_hf_token
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_cloudinary_key
META_INSTAGRAM_ACCOUNT_ID=placeholder_instagram_account_id
META_ACCESS_TOKEN=placeholder_meta_access_token
