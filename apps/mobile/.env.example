# Expo Mobile App Environment Variables Example
EXPO_PUBLIC_FIREBASE_API_KEY=placeholder_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder123456
EXPO_PUBLIC_MAPTILER_API_KEY=placeholder_maptiler_key
EXPO_PUBLIC_GEOAPIFY_API_KEY=placeholder_geoapify_key

EXPO_PUBLIC_EMAILJS_SERVICE_ID=service_placeholder
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=template_placeholder
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=placeholder_public_key
EXPO_PUBLIC_TEXTBEE_API_KEY=placeholder_textbee_api_key
EXPO_PUBLIC_TEXTBEE_DEVICE_ID=placeholder_device_id
